# Bot 配置
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 管理员 Telegram ID（你的 ID）
ADMIN_ID=YOUR_TELEGRAM_ID

# OpenAI 配置（支持自定义 URL 和模型）
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# AI 助理人设
AI_SYSTEM_PROMPT=你是主人的私人助理。请礼貌、幽默地回复用户的消息。如果遇到不确定的问题，请诚实说明并告诉用户会转达给主人。

# 对话记忆轮数（每轮 = 一问一答）
MAX_HISTORY_ROUNDS=10

# 捐赠使用 Telegram Stars（无需额外配置）
# Stars 支付不需要 provider_token，BotFather 开启 Stars 即可

# 敏感词过滤（在 data/sensitive_words.txt 中添加敏感词，每行一个）
# 触发敏感词后不调用 AI，直接返回下方设定的回复
SENSITIVE_REPLY=抱歉，您的问题触发敏感词过滤，我无法回答。。

# 捐赠门槛（用户需先累计捐赠达标才能使用 Bot）
# DONATION_REQUIRED=true 时启用门槛，用户必须先捐赠才能使用
# DONATION_MIN_AMOUNT 为解锁所需的最低累计金额（Telegram Stars）
DONATION_REQUIRED=true
DONATION_MIN_AMOUNT=10

# 加密货币捐赠（设为 true 启用，留空地址则不显示该币种）
CRYPTO_ENABLED=false
CRYPTO_BTC=
CRYPTO_ETH=
CRYPTO_USDT=
CRYPTO_TRON=
